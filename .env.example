# ==============================================================================
# NEXDESK — Enterprise IT Service Desk & Asset Management
# Environment Variables Example (Safe Placeholders Only)
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/nexdesk_db?schema=public"

# Authentication & Session Security (Min 32 characters random secret)
AUTH_SECRET="your-32-character-random-secret-goes-here-min-length"
SESSION_COOKIE_NAME="nexdesk_session"
SESSION_MAX_AGE_SECONDS=28800

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Default Demo Accounts Mode (Enabled in development only)
ENABLE_DEMO_ACCOUNTS="true"

# Optional Email / Notification Service (Disabled by default, logs to console)
EMAIL_NOTIFICATIONS_ENABLED="false"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nexdesk-notifications@example.com"
